#!/bin/ash /etc/rc.common
USE_PROCD=1
START=97
STOP=8

protected_file() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    [ "$(stat -c %u "$1")" = 0 ] || return 1
    case "$(stat -c %a "$1")" in 600|640|644|700|740|744|750|754|755) ;; *) return 1 ;; esac
}

start_service() {
    protected_file /etc/blog-sites/slow-notes/service.env || return 1
    protected_file /etc/blog-sites/slow-notes/supervisor.py || return 1
    protected_file /etc/blog-sites/slow-notes/site_guard.py || return 1
    protected_file /etc/blog-sites/slow-notes/router_tool.py || return 1
    . /etc/blog-sites/slow-notes/service.env
    [ "$SLOW_NOTES_CONFIG" = /etc/blog-sites/slow-notes/site.json ] || return 1
    [ -x "$SLOW_NOTES_PYTHON" ] || return 1
    # Only a /tmp identity directory is created; no missing disk mount is repaired.
    [ ! -L /tmp/blog-slow-notes ] || return 1
    mkdir -p /tmp/blog-slow-notes || return 1
    [ "$(stat -c %u /tmp/blog-slow-notes)" = 0 ] || return 1
    chmod 0755 /tmp/blog-slow-notes || return 1
    procd_open_instance slow-notes
    procd_set_param command "$SLOW_NOTES_PYTHON" -B /etc/blog-sites/slow-notes/supervisor.py --config "$SLOW_NOTES_CONFIG"
    procd_set_param env PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
    procd_set_param respawn 60 5 3
    procd_set_param term_timeout 35
    procd_set_param limits core=0 nofile="512 512"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
