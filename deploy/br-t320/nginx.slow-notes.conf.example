# REVIEW TEMPLATE ONLY. Add to the actual existing nginx http{} include after
# reviewing nginx -T. Never start another global nginx or replace uci.conf.
# Replace both hostnames, the dedicated certificate paths, reviewed LAN/WG
# ranges, and REPLACE_WITH_VERIFIED_PORT before nginx -t and reload.
# Certificates/CA signing/DNS/firewall changes require their own reviewed steps.
geo $slow_notes_allowed_source {
    default 0;
    192.168.1.0/24 1;
    10.77.0.0/24 1;
}

server {
    listen 443 ssl;
    server_name slow-notes.home.arpa;
    if ($server_addr != 192.168.1.1) { return 444; }
    if ($slow_notes_allowed_source = 0) { return 444; }
    if ($ssl_server_name != slow-notes.home.arpa) { return 444; }
    if ($host != slow-notes.home.arpa) { return 444; }
    ssl_certificate /etc/blog-sites/slow-notes/server.crt;
    ssl_certificate_key /etc/blog-sites/slow-notes/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    autoindex off;
    add_header X-Robots-Tag "noindex, nofollow" always;
    location ~ ^/(?:api|admin)(?:/|$) { return 404; }
    location ~ /\. { return 404; }
    location = /healthz { return 404; }
    location / {
        proxy_pass http://127.0.0.1:REPLACE_WITH_VERIFIED_PORT;
        proxy_set_header Host slow-notes.home.arpa;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }
}

server {
    listen 443 ssl;
    server_name slow-notes.home.arpa.admin;
    if ($server_addr != 192.168.1.1) { return 444; }
    if ($slow_notes_allowed_source = 0) { return 444; }
    if ($ssl_server_name != slow-notes.home.arpa.admin) { return 444; }
    if ($host != slow-notes.home.arpa.admin) { return 444; }
    ssl_certificate /etc/blog-sites/slow-notes/server.crt;
    ssl_certificate_key /etc/blog-sites/slow-notes/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    autoindex off;
    client_max_body_size 11m;
    client_body_timeout 20s;
    add_header X-Robots-Tag "noindex, nofollow" always;
    location = / { return 302 /admin/; }
    location ~ /\. { return 404; }
    location = /healthz { return 404; }
    # CMS handles administrator sessions, CSRF, exact editor Origin and login
    # throttling. No private data directory is served by nginx.
    location / {
        proxy_pass http://127.0.0.1:REPLACE_WITH_VERIFIED_PORT;
        proxy_set_header Host slow-notes.home.arpa.admin;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}
